# Dhundo - Environment Configuration Template
# Copy this file to '.env' and fill in your keys:
#   cp .env.example .env

# Google Maps API Key
# Required for Google Maps, Static Maps, Geocoding, and Street View.
# Get a key from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Firebase API Keys
# Available in your Firebase Console under Project Settings > General
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key_here
FIREBASE_WINDOWS_API_KEY=your_firebase_windows_api_key_here
